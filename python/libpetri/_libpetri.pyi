"""Type stubs for the libpetri PyO3 extension module.

These signatures describe the raw Rust surface exposed by `libpetri._libpetri`.
End users should import from the `libpetri` package (which wraps these), not
this module directly.
"""

from __future__ import annotations

import builtins
import os
from collections.abc import Awaitable, Callable, Iterable, Mapping
from enum import Enum
from typing import Any

# ---------------------------------------------------------------------------
# Exception hierarchy
# ---------------------------------------------------------------------------

class LibpetriError(RuntimeError): ...
class CallbackError(LibpetriError): ...
class StructureError(ValueError): ...

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------

HAS_TOKIO: bool
HAS_Z3: bool
HAS_DEBUG: bool

