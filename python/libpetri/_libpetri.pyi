    def is_violated(self) -> bool: ...

class PropertyResult:
    # `property` as a getter name shadows the `@property` decorator within the
    # class body, so use the fully qualified `@builtins.property` here.
    @builtins.property
    def property(self) -> SmtProperty: ...
    @builtins.property
    def result(self) -> VerificationResult: ...

class SubnetVerificationResult:
    def synthetic_net(self) -> Net: ...
    def property_results(self) -> list[PropertyResult]: ...
    def all_proven(self) -> bool: ...
    def any_violated(self) -> bool: ...

