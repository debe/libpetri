{
  "name": "libpetri-debug-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html ../java/src/main/resources/debug-ui/index.html",
    "preview": "vite preview",
    "docs": "node --import ./register-hooks.mjs --import tsx ./node_modules/.bin/typedoc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@viz-js/viz": "^3.27.0",
    "libpetri": "file:../typescript",
    "panzoom": "^9.4.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.6"
  }
}
