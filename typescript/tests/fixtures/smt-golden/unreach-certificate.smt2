; IC3/PDR certificate check (plain SMT-LIB2, not HORN):
; each VC below must be unsat for the certificate to stand.
(define-fun Error () Bool
    false)
(define-fun Reachable ((x!0 Int)
   (x!1 Int)
   (x!2 Int)
   (x!3 Int)
   (x!4 Int)
   (x!5 Int)) Bool
    (not (>= x!5 1)))

(declare-const m0 Int)
(declare-const m1 Int)
(declare-const m2 Int)
(declare-const m3 Int)
(declare-const m4 Int)
(declare-const m5 Int)
(declare-const m0p Int)
(declare-const m1p Int)
(declare-const m2p Int)
(declare-const m3p Int)
(declare-const m4p Int)
(declare-const m5p Int)

; VC1 initiation (VC1)
(push)
(assert (not (and (Reachable 1 0 0 0 0 0) (= (* 1 0) 0))))
(check-sat)
(pop)

; VC2 consecution (VC2)
(push)
(assert (>= m0 0))
(assert (>= m1 0))
(assert (>= m2 0))
(assert (>= m3 0))
(assert (>= m4 0))
(assert (>= m5 0))
(assert (and (Reachable m0 m1 m2 m3 m4 m5) (= (* 1 m2) 0)))
(assert (or (and (>= m0 1) (>= m3 1) (= m1 0) (>= m2 1) (= m0p (- m0 1)) (= m1p m1) (= m2p m2) (= m3p (- m3 1)) (= m4p 0) (= m5p (+ m5 1)) (>= m0p 0) (>= m1p 0) (>= m2p 0) (>= m3p 0) (>= m4p 0) (>= m5p 0) (<= m3p 2))
    (and (>= m1 1) (= m0p (+ m0 1)) (= m1p 0) (= m2p m2) (= m3p m3) (= m4p (+ m4 1)) (= m5p m5) (>= m0p 0) (>= m1p 0) (>= m2p 0) (>= m3p 0) (>= m4p 0) (>= m5p 0) (<= m3p 2))
    (and (< m3 2) (= m0p m0) (= m1p m1) (= m2p m2) (= m3p (+ m3 1)) (= m4p m4) (= m5p m5))))
(assert (not (and (Reachable m0p m1p m2p m3p m4p m5p) (= (* 1 m2p) 0))))
(check-sat)
(pop)

; VC3 safety (VC3)
(push)
(assert (>= m0 0))
(assert (>= m1 0))
(assert (>= m2 0))
(assert (>= m3 0))
(assert (>= m4 0))
(assert (>= m5 0))
(assert (and (Reachable m0 m1 m2 m3 m4 m5) (= (* 1 m2) 0)))
(assert (and (>= m0 1) (>= m5 1)))
(check-sat)
(pop)