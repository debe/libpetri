(set-option :produce-proofs true)
(set-logic HORN)

(declare-fun Reachable (Int Int Int Int Int Int) Bool)
(declare-fun Error () Bool)

(assert (Reachable 1 2 1 0 0 0))

(assert (forall ((m0 Int) (m1 Int) (m2 Int) (m3 Int) (m4 Int) (m5 Int) (m0p Int) (m1p Int) (m2p Int) (m3p Int) (m4p Int) (m5p Int))
  (=> (and (Reachable m0 m1 m2 m3 m4 m5)
            (>= m0 1)
            (>= m3 1)
            (= m1 0)
            (>= m2 1)
            (= m0p (- m0 1))
            (= m1p m1)
            (= m2p m2)
            (= m3p (- m3 1))
            (= m4p 0)
            (= m5p (+ m5 1))
            (>= m0p 0)
            (>= m1p 0)
            (>= m2p 0)
            (>= m3p 0)
            (>= m4p 0)
            (>= m5p 0)
            (= (* 1 m2p) 1))
      (Reachable m0p m1p m2p m3p m4p m5p))))
(assert (forall ((m0 Int) (m1 Int) (m2 Int) (m3 Int) (m4 Int) (m5 Int) (m0p Int) (m1p Int) (m2p Int) (m3p Int) (m4p Int) (m5p Int))
  (=> (and (Reachable m0 m1 m2 m3 m4 m5)
            (>= m1 1)
            (= m0p (+ m0 1))
            (= m1p 0)
            (= m2p m2)
            (= m3p m3)
            (= m4p (+ m4 1))
            (= m5p m5)
            (>= m0p 0)
            (>= m1p 0)
            (>= m2p 0)
            (>= m3p 0)
            (>= m4p 0)
            (>= m5p 0)
            (= (* 1 m2p) 1))
      (Reachable m0p m1p m2p m3p m4p m5p))))
(assert (forall ((m0 Int) (m1 Int) (m2 Int) (m3 Int) (m4 Int) (m5 Int) (m0p Int) (m1p Int) (m2p Int) (m3p Int) (m4p Int) (m5p Int))
  (=> (and (Reachable m0 m1 m2 m3 m4 m5)
            (= m0p m0)
            (= m1p m1)
            (= m2p m2)
            (= m3p (+ m3 1))
            (= m4p m4)
            (= m5p m5))
      (Reachable m0p m1p m2p m3p m4p m5p))))

(assert (forall ((m0 Int) (m1 Int) (m2 Int) (m3 Int) (m4 Int) (m5 Int))
  (=> (and (Reachable m0 m1 m2 m3 m4 m5) (and (or (< m0 1) (> m1 0) (< m2 1))
         (or (< m1 1))
         (= m5 0)))
      Error)))

(assert (not Error))
(check-sat)
(get-proof)
(get-model)