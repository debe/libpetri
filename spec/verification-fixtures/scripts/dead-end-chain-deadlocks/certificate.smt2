; IC3/PDR certificate check (plain SMT-LIB2, not HORN):
; each VC below must be unsat for the certificate to stand.
(define-fun Reachable ((x!0 Int) (x!1 Int) (x!2 Int)) Bool
    true)

(declare-const m0 Int)
(declare-const m1 Int)
(declare-const m2 Int)
(declare-const m0p Int)
(declare-const m1p Int)
(declare-const m2p Int)

; VC1 initiation (VC1)
(push)
(assert (not (and (Reachable 1 0 0) (= (+ (* 1 1) (* 1 0) (* 1 0)) 1))))
(check-sat)
(pop)

; VC2 consecution (VC2)
(push)
(assert (>= m0 0))
(assert (>= m1 0))
(assert (>= m2 0))
(assert (and (Reachable m0 m1 m2) (= (+ (* 1 m0) (* 1 m1) (* 1 m2)) 1)))
(assert (or (and (>= m0 1) (= m0p (- m0 1)) (= m1p (+ m1 1)) (= m2p m2) (>= m0p 0) (>= m1p 0) (>= m2p 0))
    (and (>= m1 1) (= m0p m0) (= m1p (- m1 1)) (= m2p (+ m2 1)) (>= m0p 0) (>= m1p 0) (>= m2p 0))))
(assert (not (and (Reachable m0p m1p m2p) (= (+ (* 1 m0p) (* 1 m1p) (* 1 m2p)) 1))))
(check-sat)
(pop)

; VC3 safety (VC3)
(push)
(assert (>= m0 0))
(assert (>= m1 0))
(assert (>= m2 0))
(assert (and (Reachable m0 m1 m2) (= (+ (* 1 m0) (* 1 m1) (* 1 m2)) 1)))
(assert (and (or (< m0 1))
         (or (< m1 1))))
(check-sat)
(pop)