(set-option :produce-proofs true)
(set-logic HORN)

(declare-fun Reachable (Int Int Int Int Int) Bool)
(declare-fun Error () Bool)

(assert (Reachable 0 0 0 1 0))

(assert (forall ((m0 Int) (m1 Int) (m2 Int) (m3 Int) (m4 Int) (m0p Int) (m1p Int) (m2p Int) (m3p Int) (m4p Int))
  (=> (and (Reachable m0 m1 m2 m3 m4)
            (>= m3 1)
            (= m0p (+ m0 1))
            (= m1p (+ m1 1))
            (= m2p m2)
            (= m3p (- m3 1))
            (= m4p m4)
            (>= m0p 0)
            (>= m1p 0)
            (>= m2p 0)
            (>= m3p 0)
            (>= m4p 0)
            (= (+ (* -1 m0p) (* 1 m1p)) 0)
            (= (+ (* 1 m0p) (* 1 m2p) (* 1 m3p)) 1)
            (= (+ (* -1 m2p) (* 1 m4p)) 0))
      (Reachable m0p m1p m2p m3p m4p))))
(assert (forall ((m0 Int) (m1 Int) (m2 Int) (m3 Int) (m4 Int) (m0p Int) (m1p Int) (m2p Int) (m3p Int) (m4p Int))
  (=> (and (Reachable m0 m1 m2 m3 m4)
            (>= m0 1)
            (>= m1 1)
            (= m0p (- m0 1))
            (= m1p (- m1 1))
            (= m2p (+ m2 1))
            (= m3p m3)
            (= m4p (+ m4 1))
            (>= m0p 0)
            (>= m1p 0)
            (>= m2p 0)
            (>= m3p 0)
            (>= m4p 0)
            (= (+ (* -1 m0p) (* 1 m1p)) 0)
            (= (+ (* 1 m0p) (* 1 m2p) (* 1 m3p)) 1)
            (= (+ (* -1 m2p) (* 1 m4p)) 0))
      (Reachable m0p m1p m2p m3p m4p))))

(assert (forall ((m0 Int) (m1 Int) (m2 Int) (m3 Int) (m4 Int))
  (=> (and (Reachable m0 m1 m2 m3 m4) (and (or (< m3 1))
         (or (< m0 1) (< m1 1))
         (or (>= m0 1) (>= m1 1) (>= m3 1) (>= m4 1))))
      Error)))

(assert (not Error))
(check-sat)
(get-proof)
(get-model)