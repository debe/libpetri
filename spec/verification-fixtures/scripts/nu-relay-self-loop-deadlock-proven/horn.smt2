  (=> (and (Reachable m0 m1_0 m1_1 m2 m3_0 m3_1 m4_0 m4_1) (and (or (< m0 1) (and (or (>= m1_0 1) (>= m3_0 1) (>= m4_0 1)) (or (>= m1_1 1) (>= m3_1 1) (>= m4_1 1)))) (and (or (= m1_0 0) (= m3_0 0)) (or (= m1_1 0) (= m3_1 0))) (and (or (= m1_0 0) (= m4_0 0)) (or (= m1_1 0) (= m4_1 0))) (or (>= m0 1) (>= (+ m1_0 m1_1) 1) (>= (+ m3_0 m3_1) 1) (>= (+ m4_0 m4_1) 1))))
