; Bounded run (VER-019): 8 steps of the exact step relation from M0, idle
; only at the end; sat = a run to a violating marking.
(set-logic QF_LIA)
(declare-const s0 Int)
(declare-const s1 Int)
(declare-const s2 Int)
(declare-const s3 Int)
(declare-const s4 Int)
(declare-const s5 Int)
(declare-const s6 Int)
(declare-const s7 Int)
(declare-const m1_0 Int)
(declare-const m1_1 Int)
(declare-const m2_0 Int)
(declare-const m2_1 Int)
(declare-const m3_0 Int)
(declare-const m3_1 Int)
(declare-const m4_0 Int)
(declare-const m4_1 Int)
(declare-const m5_0 Int)
(declare-const m5_1 Int)
(declare-const m6_0 Int)
(declare-const m6_1 Int)
(declare-const m7_0 Int)
(declare-const m7_1 Int)
(declare-const m8_0 Int)
(declare-const m8_1 Int)
(assert (and (>= s0 0) (<= s0 1)))
(assert (=> (= s0 1) (= s1 1)))
(assert (=> (= s0 0) (>= 1 1)))
(assert (= m1_0 0))
(assert (= m1_1 (ite (= s0 0) (- 1 1) 1)))
(assert (and (>= s1 0) (<= s1 1)))
(assert (=> (= s1 1) (= s2 1)))
(assert (=> (= s1 0) (>= m1_1 1)))
(assert (= m2_0 m1_0))
(assert (= m2_1 (ite (= s1 0) (- m1_1 1) m1_1)))
(assert (and (>= s2 0) (<= s2 1)))
(assert (=> (= s2 1) (= s3 1)))
(assert (=> (= s2 0) (>= m2_1 1)))
(assert (= m3_0 m2_0))
(assert (= m3_1 (ite (= s2 0) (- m2_1 1) m2_1)))
(assert (and (>= s3 0) (<= s3 1)))
(assert (=> (= s3 1) (= s4 1)))
(assert (=> (= s3 0) (>= m3_1 1)))
(assert (= m4_0 m3_0))
(assert (= m4_1 (ite (= s3 0) (- m3_1 1) m3_1)))
(assert (and (>= s4 0) (<= s4 1)))
(assert (=> (= s4 1) (= s5 1)))
(assert (=> (= s4 0) (>= m4_1 1)))
(assert (= m5_0 m4_0))
(assert (= m5_1 (ite (= s4 0) (- m4_1 1) m4_1)))
(assert (and (>= s5 0) (<= s5 1)))
(assert (=> (= s5 1) (= s6 1)))
(assert (=> (= s5 0) (>= m5_1 1)))
(assert (= m6_0 m5_0))
(assert (= m6_1 (ite (= s5 0) (- m5_1 1) m5_1)))
(assert (and (>= s6 0) (<= s6 1)))
(assert (=> (= s6 1) (= s7 1)))
(assert (=> (= s6 0) (>= m6_1 1)))
(assert (= m7_0 m6_0))
(assert (= m7_1 (ite (= s6 0) (- m6_1 1) m6_1)))
(assert (and (>= s7 0) (<= s7 1)))
(assert (=> (= s7 0) (>= m7_1 1)))
(assert (= m8_0 m7_0))
(assert (= m8_1 (ite (= s7 0) (- m7_1 1) m7_1)))
(assert (and (or (< m8_1 1))
         (= m8_0 0)))
(check-sat)
(get-model)