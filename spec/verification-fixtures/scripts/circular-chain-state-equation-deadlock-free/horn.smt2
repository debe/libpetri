(set-option :produce-proofs true)
(set-logic HORN)

(declare-fun Reachable (Int Int Int Int Int Int) Bool)
(declare-fun Error () Bool)

(assert (Reachable 1 0 0 0 0 0))

(assert (forall ((m0 Int) (m1 Int) (m2 Int) (m0p Int) (m1p Int) (m2p Int) (n0 Int) (n1 Int) (n2 Int) (n0p Int) (n1p Int) (n2p Int))
  (=> (and (Reachable m0 m1 m2 n0 n1 n2)
            (>= m0 1)
            (= m0p (- m0 1))
            (= m1p (+ m1 1))
            (= m2p m2)
            (>= m0p 0)
            (>= m1p 0)
            (>= m2p 0)
            (= (+ (* 1 m0p) (* 1 m1p) (* 1 m2p)) 1)
            (= n0p (+ n0 1))
            (= n1p n1)
            (= n2p n2)
            (>= n0p 0)
            (>= n1p 0)
            (>= n2p 0)
            (= m0p (+ 1 (- n0p) n2p))
            (= m1p (+ 0 n0p (- n1p)))
            (= m2p (+ 0 n1p (- n2p))))
      (Reachable m0p m1p m2p n0p n1p n2p))))
(assert (forall ((m0 Int) (m1 Int) (m2 Int) (m0p Int) (m1p Int) (m2p Int) (n0 Int) (n1 Int) (n2 Int) (n0p Int) (n1p Int) (n2p Int))
  (=> (and (Reachable m0 m1 m2 n0 n1 n2)
            (>= m1 1)
            (= m0p m0)
            (= m1p (- m1 1))
            (= m2p (+ m2 1))
            (>= m0p 0)
            (>= m1p 0)
            (>= m2p 0)
            (= (+ (* 1 m0p) (* 1 m1p) (* 1 m2p)) 1)
            (= n0p n0)
            (= n1p (+ n1 1))
            (= n2p n2)
            (>= n0p 0)
            (>= n1p 0)
            (>= n2p 0)
            (= m0p (+ 1 (- n0p) n2p))
            (= m1p (+ 0 n0p (- n1p)))
            (= m2p (+ 0 n1p (- n2p))))
      (Reachable m0p m1p m2p n0p n1p n2p))))
(assert (forall ((m0 Int) (m1 Int) (m2 Int) (m0p Int) (m1p Int) (m2p Int) (n0 Int) (n1 Int) (n2 Int) (n0p Int) (n1p Int) (n2p Int))
  (=> (and (Reachable m0 m1 m2 n0 n1 n2)
            (>= m2 1)
            (= m0p (+ m0 1))
            (= m1p m1)
            (= m2p (- m2 1))
            (>= m0p 0)
            (>= m1p 0)
            (>= m2p 0)
            (= (+ (* 1 m0p) (* 1 m1p) (* 1 m2p)) 1)
            (= n0p n0)
            (= n1p n1)
            (= n2p (+ n2 1))
            (>= n0p 0)
            (>= n1p 0)
            (>= n2p 0)
            (= m0p (+ 1 (- n0p) n2p))
            (= m1p (+ 0 n0p (- n1p)))
            (= m2p (+ 0 n1p (- n2p))))
      (Reachable m0p m1p m2p n0p n1p n2p))))

(assert (forall ((m0 Int) (m1 Int) (m2 Int) (n0 Int) (n1 Int) (n2 Int))
  (=> (and (Reachable m0 m1 m2 n0 n1 n2) (and (or (< m0 1))
         (or (< m1 1))
         (or (< m2 1))
         (or (>= m0 1) (>= m1 1) (>= m2 1))))
      Error)))

(assert (not Error))
(check-sat)
(get-proof)
(get-model)