(set-logic HORN)

(declare-fun Reachable (Int Int Int Int Int Int) Bool)
(declare-fun Error () Bool)

(assert (Reachable 1 0 0 0 0 0))

(assert (forall ((m0 Int) (m1 Int) (m2_0 Int) (m3_0 Int) (m4 Int) (m5_0 Int) (m0p Int) (m1p Int) (m2_0p Int) (m3_0p Int) (m4p Int) (m5_0p Int))
  (=> (and (Reachable m0 m1 m2_0 m3_0 m4 m5_0)
            (>= m0 1)
            (= m2_0 0)
            (= m3_0 0)
            (= m5_0 0)
            (= m0p (- m0 1))
            (>= m0p 0)
            (= m1p m1)
            (= m2_0p (+ m2_0 1))
            (>= m2_0p 0)
            (= m3_0p m3_0)
            (= m4p m4)
            (= m5_0p m5_0)
            (= (+ m0p m1p m2_0p m3_0p m4p) 1)
            (= (+ m3_0p m5_0p) 0))
      (Reachable m0p m1p m2_0p m3_0p m4p m5_0p))))
(assert (forall ((m0 Int) (m1 Int) (m2_0 Int) (m3_0 Int) (m4 Int) (m5_0 Int) (m0p Int) (m1p Int) (m2_0p Int) (m3_0p Int) (m4p Int) (m5_0p Int))
  (=> (and (Reachable m0 m1 m2_0 m3_0 m4 m5_0)
            (>= m2_0 1)
            (>= m5_0 1)
            (= m0p m0)
            (= m1p m1)
            (= m2_0p (- m2_0 1))
            (>= m2_0p 0)
            (= m3_0p (+ m3_0 1))
            (>= m3_0p 0)
            (= m4p m4)
            (= m5_0p (- m5_0 1))
            (>= m5_0p 0)
            (= (+ m0p m1p m2_0p m3_0p m4p) 1)
            (= (+ m3_0p m5_0p) 0))
      (Reachable m0p m1p m2_0p m3_0p m4p m5_0p))))
(assert (forall ((m0 Int) (m1 Int) (m2_0 Int) (m3_0 Int) (m4 Int) (m5_0 Int) (m0p Int) (m1p Int) (m2_0p Int) (m3_0p Int) (m4p Int) (m5_0p Int))
  (=> (and (Reachable m0 m1 m2_0 m3_0 m4 m5_0)
            (>= m3_0 1)
            (= m0p m0)
            (= m1p m1)
            (= m2_0p m2_0)
            (= m3_0p (- m3_0 1))
            (>= m3_0p 0)
            (= m4p (+ m4 1))
            (>= m4p 0)
            (= m5_0p (+ m5_0 1))
            (>= m5_0p 0)
            (= (+ m0p m1p m2_0p m3_0p m4p) 1)
            (= (+ m3_0p m5_0p) 0))
      (Reachable m0p m1p m2_0p m3_0p m4p m5_0p))))
(assert (forall ((m0 Int) (m1 Int) (m2_0 Int) (m3_0 Int) (m4 Int) (m5_0 Int) (m0p Int) (m1p Int) (m2_0p Int) (m3_0p Int) (m4p Int) (m5_0p Int))
  (=> (and (Reachable m0 m1 m2_0 m3_0 m4 m5_0)
            (>= m4 1)
            (= m0p m0)
            (= m1p (+ m1 1))
            (>= m1p 0)
            (= m2_0p m2_0)
            (= m3_0p m3_0)
            (= m4p (- m4 1))
            (>= m4p 0)
            (= m5_0p m5_0)
            (= (+ m0p m1p m2_0p m3_0p m4p) 1)
            (= (+ m3_0p m5_0p) 0))
      (Reachable m0p m1p m2_0p m3_0p m4p m5_0p))))

(assert (forall ((m0 Int) (m1 Int) (m2_0 Int) (m3_0 Int) (m4 Int) (m5_0 Int))
  (=> (and (Reachable m0 m1 m2_0 m3_0 m4 m5_0) (and (or (< m0 1) (and (or (>= m2_0 1) (>= m3_0 1) (>= m5_0 1)))) (and (or (= m2_0 0) (= m5_0 0))) (and (= m3_0 0)) (< m4 1) (or (>= m0 1) (>= m2_0 1) (>= m3_0 1) (>= m4 1) (>= m5_0 1))))
      Error)))

(assert (not Error))
(check-sat)