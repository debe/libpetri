(set-option :produce-proofs true)
(set-logic HORN)

(declare-fun Reachable (Int Int Int Int) Bool)
(declare-fun Error () Bool)

(assert (Reachable 0 0 0 1))

(assert (forall ((m0 Int) (m1 Int) (m2 Int) (m3 Int) (m0p Int) (m1p Int) (m2p Int) (m3p Int))
  (=> (and (Reachable m0 m1 m2 m3)
            (>= m3 1)
            (= m0p (+ m0 1))
            (= m1p (+ m1 1))
            (= m2p m2)
            (= m3p (- m3 1))
            (>= m0p 0)
            (>= m1p 0)
            (>= m2p 0)
            (>= m3p 0)
            (= (+ (* -1 m0p) (* 1 m1p)) 0)
            (= (* 1 m2p) 0))
      (Reachable m0p m1p m2p m3p))))
(assert (forall ((m0 Int) (m1 Int) (m2 Int) (m3 Int) (m0p Int) (m1p Int) (m2p Int) (m3p Int))
  (=> (and (Reachable m0 m1 m2 m3)
            (>= m0 1)
            (>= m1 1)
            (= m0p (- m0 1))
            (= m1p (- m1 1))
            (= m2p m2)
            (= m3p m3)
            (>= m0p 0)
            (>= m1p 0)
            (>= m2p 0)
            (>= m3p 0)
            (= (+ (* -1 m0p) (* 1 m1p)) 0)
            (= (* 1 m2p) 0))
      (Reachable m0p m1p m2p m3p))))

(assert (forall ((m0 Int) (m1 Int) (m2 Int) (m3 Int))
  (=> (and (Reachable m0 m1 m2 m3) (and (or (< m3 1))
         (or (< m0 1) (< m1 1))
         (= m2 0)))
      Error)))

(assert (not Error))
(check-sat)
(get-proof)
(get-model)