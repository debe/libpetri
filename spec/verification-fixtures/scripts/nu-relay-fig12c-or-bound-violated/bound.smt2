; Linear state-equation bound (VER-015): y >= 0 with y.C <= 0 on every
; transition gives y.M <= y.M0 for every reachable M; sat = the violating
; markings' demand exceeds that bound, so none is reachable.
(set-logic QF_LIA)
(declare-const y0 Int)
(declare-const y1 Int)
(declare-const y2 Int)
(declare-const y3 Int)
(declare-const y4 Int)
(declare-const y5 Int)
(declare-const y6 Int)
(declare-const y7 Int)
(assert (>= y0 0))
(assert (>= y1 0))
(assert (>= y2 0))
(assert (>= y3 0))
(assert (>= y4 0))
(assert (>= y5 0))
(assert (>= y6 0))
(assert (>= y7 0))
(assert (<= (+ y4 y5 (- y7)) 0))
(assert (<= (+ y0 y1 (- y5)) 0))
(assert (<= (+ (- y0) y2) 0))
(assert (<= (+ (- y1) y3) 0))
(assert (<= (+ (- y2) (- y3) y6) 0))
(assert (<= (+ (- y4) (- y6) y7) 0))
(assert (<= (+ (- y4) (- y6) y7) 0))
(assert (>= (* 2 y4) (+ 1 (* 2 y7))))
(check-sat)
(get-model)