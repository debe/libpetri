{
  "description": "Shared parity cases for the colour-slot linear program of NU-053. The inputs (places, coloured places, marking, flat rows with pre and post counts) are written by hand. Each 'expected' object is written by the Rust script-parity test under scripts/smt-script-parity.py --update and read by every implementation: status, presolved places and rows, pivots, optimum, k and the scaled weighting (non-zero weights by place, and the denominator).",
  "version": 1,
  "cases": [
    {
      "id": "reset-budget",
      "note": "A reset arc on the uncoloured budget keeps a free weight there (no H1): optimum 4.",
      "places": ["a", "b", "budget", "r", "r2"],
      "coloured": ["a", "b"],
      "marking": {"budget": 2, "r": 1},
      "rows": [
        {"name": "mint", "pre": {"budget": 1}, "post": {"a": 1, "b": 1}},
        {"name": "join", "pre": {"a": 1, "b": 1}, "post": {"budget": 1}},
        {"name": "cancel", "pre": {"r": 1}, "post": {"r2": 1}, "reset": ["budget"]}
      ],
      "expected": {
        "status": "optimal",
        "places": 3,
        "rows": 2,
        "pivots": 1,
        "optimum": "4",
        "k": 4,
        "weights": {"a": "1", "b": "1", "budget": "2"},
        "denominator": "1"
      }
    },
    {
      "id": "all-budget-drain",
      "note": "An all(budget) drain beside the loop: optimum 4.",
      "places": ["a", "b", "budget", "r", "r2"],
      "coloured": ["a", "b"],
      "marking": {"budget": 2, "r": 1},
      "rows": [
        {"name": "mint", "pre": {"budget": 1}, "post": {"a": 1, "b": 1}},
        {"name": "join", "pre": {"a": 1, "b": 1}, "post": {"budget": 1}},
        {
          "name": "cancel",
          "pre": {"budget": 1, "r": 1},
          "post": {"r2": 1},
          "consumeAll": ["budget"]
        }
      ],
      "expected": {
        "status": "optimal",
        "places": 3,
        "rows": 2,
        "pivots": 1,
        "optimum": "4",
        "k": 4,
        "weights": {"a": "1", "b": "1", "budget": "2"},
        "denominator": "1"
      }
    },
    {
      "id": "arrivals-3",
      "note": "Arrivals(3) closed into a source; the decline row destroys a token, so no semiflow covers the keys: optimum 6.",
      "places": ["a", "b", "done", "env:arrivals[0]", "req"],
      "coloured": ["a", "b"],
      "marking": {"env:arrivals[0]": 3},
      "rows": [
        {"name": "env:arrive[0]:req", "pre": {"env:arrivals[0]": 1}, "post": {"req": 1}},
        {"name": "env:decline[0]", "pre": {"env:arrivals[0]": 1}, "post": {}},
        {"name": "mint", "pre": {"req": 1}, "post": {"a": 1, "b": 1}},
        {"name": "join", "pre": {"a": 1, "b": 1}, "post": {"done": 1}}
      ],
      "expected": {
        "status": "optimal",
        "places": 4,
        "rows": 2,
        "pivots": 2,
        "optimum": "6",
        "k": 6,
        "weights": {"a": "1", "b": "1", "env:arrivals[0]": "2", "req": "2"},
        "denominator": "1"
      }
    },
    {
      "id": "timeout-forward-exactly-2",
      "note": "A timeout forward of exactly(2) requests deposits 2 into the mint's input queue: optimum 8.",
      "places": ["a", "b", "budget", "dropped", "queue", "req"],
      "coloured": ["a", "b"],
      "marking": {"budget": 5, "req": 4},
      "rows": [
        {"name": "batch", "pre": {"req": 2}, "post": {"dropped": 1}},
        {"name": "batch_b1", "pre": {"req": 2}, "post": {"queue": 2}},
        {"name": "mint", "pre": {"budget": 1, "queue": 1}, "post": {"a": 1, "b": 1}},
        {"name": "join", "pre": {"a": 1, "b": 1}, "post": {"budget": 1}}
      ],
      "expected": {
        "status": "optimal",
        "places": 5,
        "rows": 3,
        "pivots": 2,
        "optimum": "8",
        "k": 8,
        "weights": {"a": "1", "b": "1", "queue": "2", "req": "2"},
        "denominator": "1"
      }
    },
